prefix=@PREFIX@
libdir=@LIBDIR@
includedir=@INCLUDEDIR@
datadir=@DATADIR@
# the hosting items as TypeScript modules, omx-clap-core-hosting.js and omx-clap-core-vocabulary.js and their .d.ts
tsdir=${datadir}/omx-clap-core/ts

Name: omx-clap-core
Description: The CLAP hosting core of omx-clap-host: a plugin's process() on the caller's RT thread and the control thread that owns the plugin
Version: @VERSION@
Requires: clap
# hosted_stage.h takes its DSP words from omx-dsp's headers, which name omx-contract's; clap_host.h its hosting codes
# from omx_clap_core_vocabulary.h, installed beside it; nothing of either is linked
Requires.private: omxdsp >= 0.18.0, omx-contract >= 3.0.0
Libs: -L${libdir} -lomx-clap-core
Cflags: -I${includedir}
