prefix=@PREFIX@
libdir=@LIBDIR@
includedir=@INCLUDEDIR@
datadir=@DATADIR@
# the hosting items as a TypeScript module, omx-clap-core-hosting.js and its .d.ts
tsdir=${datadir}/omx-clap-core/ts

Name: omx-clap-core
Description: The CLAP hosting core of omx-clap-host: a plugin's process() on the caller's RT thread and the control thread that owns the plugin
Version: @VERSION@
Requires: clap
# hosted_stage.h takes its DSP words from omx-dsp's headers, clap_host.h its hosting codes from omx-contract's
# omx_vocabulary.h; nothing of either is linked
Requires.private: omxdsp >= 0.18.0, omx-contract >= 2.19.0
Libs: -L${libdir} -lomx-clap-core
Cflags: -I${includedir}
