# lv2_cv_fixture.c's ports: one audio input and output, one CV input and one CV output. The #many twin has sixteen CV
# inputs and the #many-out twin sixteen CV outputs (ams-lv2's multiphase_lfo has sixteen, omx-clap-core #268): twice
# the cap of 8 the adapter once had; every CV port counts against the auxiliary limit of 64 a side and nothing else.
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .

<urn:openmixer:test:cv-fixture>
    a lv2:Plugin , lv2:UtilityPlugin ;
    doap:name "openmixer cv fixture" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a lv2:CVPort , lv2:InputPort ; lv2:index 2 ; lv2:symbol "mod" ; lv2:name "Mod"
    ] , [
        a lv2:CVPort , lv2:OutputPort ; lv2:index 3 ; lv2:symbol "env" ; lv2:name "Env"
    ] .

<urn:openmixer:test:cv-fixture#many>
    a lv2:Plugin ;
    doap:name "openmixer cv fixture (sixteen CV inputs twin)" ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a lv2:CVPort , lv2:InputPort ; lv2:index 2 ; lv2:symbol "cv0" ; lv2:name "CV 0"
    ] , [
        a lv2:CVPort , lv2:InputPort ; lv2:index 3 ; lv2:symbol "cv1" ; lv2:name "CV 1"
    ] , [
        a lv2:CVPort , lv2:InputPort ; lv2:index 4 ; lv2:symbol "cv2" ; lv2:name "CV 2"
    ] , [
        a lv2:CVPort , lv2:InputPort ; lv2:index 5 ; lv2:symbol "cv3" ; lv2:name "CV 3"
    ] , [
        a lv2:CVPort , lv2:InputPort ; lv2:index 6 ; lv2:symbol "cv4" ; lv2:name "CV 4"
    ] , [
        a lv2:CVPort , lv2:InputPort ; lv2:index 7 ; lv2:symbol "cv5" ; lv2:name "CV 5"
    ] , [
        a lv2:CVPort , lv2:InputPort ; lv2:index 8 ; lv2:symbol "cv6" ; lv2:name "CV 6"
    ] , [
        a lv2:CVPort , lv2:InputPort ; lv2:index 9 ; lv2:symbol "cv7" ; lv2:name "CV 7"
    ] , [
        a lv2:CVPort , lv2:InputPort ; lv2:index 10 ; lv2:symbol "cv8" ; lv2:name "CV 8"
    ] , [
        a lv2:CVPort , lv2:InputPort ; lv2:index 11 ; lv2:symbol "cv9" ; lv2:name "CV 9"
    ] , [
        a lv2:CVPort , lv2:InputPort ; lv2:index 12 ; lv2:symbol "cv10" ; lv2:name "CV 10"
    ] , [
        a lv2:CVPort , lv2:InputPort ; lv2:index 13 ; lv2:symbol "cv11" ; lv2:name "CV 11"
    ] , [
        a lv2:CVPort , lv2:InputPort ; lv2:index 14 ; lv2:symbol "cv12" ; lv2:name "CV 12"
    ] , [
        a lv2:CVPort , lv2:InputPort ; lv2:index 15 ; lv2:symbol "cv13" ; lv2:name "CV 13"
    ] , [
        a lv2:CVPort , lv2:InputPort ; lv2:index 16 ; lv2:symbol "cv14" ; lv2:name "CV 14"
    ] , [
        a lv2:CVPort , lv2:InputPort ; lv2:index 17 ; lv2:symbol "cv15" ; lv2:name "CV 15"
    ] .

<urn:openmixer:test:cv-fixture#many-out>
    a lv2:Plugin ;
    doap:name "openmixer cv fixture (sixteen CV outputs twin)" ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a lv2:CVPort , lv2:OutputPort ; lv2:index 2 ; lv2:symbol "cv0" ; lv2:name "CV 0"
    ] , [
        a lv2:CVPort , lv2:OutputPort ; lv2:index 3 ; lv2:symbol "cv1" ; lv2:name "CV 1"
    ] , [
        a lv2:CVPort , lv2:OutputPort ; lv2:index 4 ; lv2:symbol "cv2" ; lv2:name "CV 2"
    ] , [
        a lv2:CVPort , lv2:OutputPort ; lv2:index 5 ; lv2:symbol "cv3" ; lv2:name "CV 3"
    ] , [
        a lv2:CVPort , lv2:OutputPort ; lv2:index 6 ; lv2:symbol "cv4" ; lv2:name "CV 4"
    ] , [
        a lv2:CVPort , lv2:OutputPort ; lv2:index 7 ; lv2:symbol "cv5" ; lv2:name "CV 5"
    ] , [
        a lv2:CVPort , lv2:OutputPort ; lv2:index 8 ; lv2:symbol "cv6" ; lv2:name "CV 6"
    ] , [
        a lv2:CVPort , lv2:OutputPort ; lv2:index 9 ; lv2:symbol "cv7" ; lv2:name "CV 7"
    ] , [
        a lv2:CVPort , lv2:OutputPort ; lv2:index 10 ; lv2:symbol "cv8" ; lv2:name "CV 8"
    ] , [
        a lv2:CVPort , lv2:OutputPort ; lv2:index 11 ; lv2:symbol "cv9" ; lv2:name "CV 9"
    ] , [
        a lv2:CVPort , lv2:OutputPort ; lv2:index 12 ; lv2:symbol "cv10" ; lv2:name "CV 10"
    ] , [
        a lv2:CVPort , lv2:OutputPort ; lv2:index 13 ; lv2:symbol "cv11" ; lv2:name "CV 11"
    ] , [
        a lv2:CVPort , lv2:OutputPort ; lv2:index 14 ; lv2:symbol "cv12" ; lv2:name "CV 12"
    ] , [
        a lv2:CVPort , lv2:OutputPort ; lv2:index 15 ; lv2:symbol "cv13" ; lv2:name "CV 13"
    ] , [
        a lv2:CVPort , lv2:OutputPort ; lv2:index 16 ; lv2:symbol "cv14" ; lv2:name "CV 14"
    ] , [
        a lv2:CVPort , lv2:OutputPort ; lv2:index 17 ; lv2:symbol "cv15" ; lv2:name "CV 15"
    ] .
