# pg:mainInput names the main group and a third input stands outside it, ungrouped and no side chain: a main group
# declared makes every other input of the side an auxiliary port, so this is admitted, the third input one mono
# auxiliary port, never a second main port
<urn:openmixer:test:sidechain-fixture#main-extra>
    a lv2:Plugin ;
    doap:name "openmixer sidechain fixture (main group and an input outside it twin)" ;
    pg:mainInput <urn:openmixer:test:sidechain-fixture#main-extra-main> ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "In L" ;
        pg:group <urn:openmixer:test:sidechain-fixture#main-extra-main>
    ] , [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "In R" ;
        pg:group <urn:openmixer:test:sidechain-fixture#main-extra-main>
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Out L"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Out R"
    ] , [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 4 ; lv2:symbol "extra" ; lv2:name "Extra"
    ] .

<urn:openmixer:test:sidechain-fixture#main-extra-main>
    a pg:Group , pg:InputGroup ;
    lv2:symbol "main_extra_main" ;
    rdfs:label "Main" .
