    ] .

<urn:openmixer:test:atom-fixture#value-in>
    a lv2:Plugin ;
    doap:name "openmixer atom fixture (an atom input that is no sequence twin)" ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a atom:AtomPort , lv2:InputPort ; atom:bufferType atom:Atom ;
        lv2:index 2 ; lv2:symbol "value" ; lv2:name "Value"
    ] .

<urn:openmixer:test:atom-fixture#ui-many>
    a lv2:Plugin ;
    doap:name "openmixer atom fixture (five control inputs twin)" ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a atom:AtomPort , lv2:InputPort ; atom:bufferType atom:Sequence ; atom:supports fx:Peak ;
        lv2:index 2 ; lv2:symbol "control0" ; lv2:name "Control 0"
    ] , [
        a atom:AtomPort , lv2:InputPort ; atom:bufferType atom:Sequence ; atom:supports fx:Peak ;
        lv2:index 3 ; lv2:symbol "control1" ; lv2:name "Control 1"
    ] , [
        a atom:AtomPort , lv2:InputPort ; atom:bufferType atom:Sequence ; atom:supports fx:Peak ;
        lv2:index 4 ; lv2:symbol "control2" ; lv2:name "Control 2"
    ] , [
        a atom:AtomPort , lv2:InputPort ; atom:bufferType atom:Sequence ; atom:supports fx:Peak ;
        lv2:index 5 ; lv2:symbol "control3" ; lv2:name "Control 3"
    ] , [
        a atom:AtomPort , lv2:InputPort ; atom:bufferType atom:Sequence ; atom:supports fx:Peak ;
        lv2:index 6 ; lv2:symbol "control4" ; lv2:name "Control 4"
    ] .
