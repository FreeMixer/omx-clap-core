# The wide twins of lv2_layout_fixture.c, generated by a shell loop (the commit that adds them says how): ungrouped
# inputs and one output, so rule 3 makes the first two inputs the main pair and every other input a mono auxiliary port.
# sixty-four: 66 inputs, 64 auxiliary ports, the limit; sixty-five: 67 inputs, 65, refused. cv-sixty-four: 64 audio
# inputs and 2 CV inputs, 62 auxiliary ports and 2 CV ports, the limit; cv-sixty-five: 3 CV inputs, one past it.
# wide-sixty-five: 65 inputs in one group, by rule 2 a main port of 65 channels, one past a port's limit.
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix pg:   <http://lv2plug.in/ns/ext/port-groups#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:openmixer:test:layout-fixture#sixty-four>
    a lv2:Plugin ;
    doap:name "openmixer layout fixture (64 auxiliary inputs)" ;
    lv2:port [
