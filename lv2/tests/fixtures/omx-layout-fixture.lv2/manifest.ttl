# The audio-layout test plugins (lv2_layout_fixture.c) as a bundle of their own: every plugin of the TTL is listed here,
# as lilv reads only the plugins a manifest names.
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:openmixer:test:layout-fixture#main-aux>
    a lv2:Plugin ;
    lv2:binary <omx-layout-fixture.so> ;
    rdfs:seeAlso <omx-layout-fixture.ttl> .

<urn:openmixer:test:layout-fixture#two-mono>
    a lv2:Plugin ;
    lv2:binary <omx-layout-fixture.so> ;
    rdfs:seeAlso <omx-layout-fixture.ttl> .

