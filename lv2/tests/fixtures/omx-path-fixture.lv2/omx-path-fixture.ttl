# lv2_path_fixture.c's plugins: an audio pair and the level a save writes to a file of its own. Both require
# state:makePath; the #escape twin asks it for paths outside its directory.
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .

<urn:openmixer:test:path-fixture>
    a lv2:Plugin , lv2:UtilityPlugin ;
    doap:name "openmixer path fixture" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    lv2:requiredFeature urid:map , state:makePath ;
    lv2:extensionData state:interface ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 2 ; lv2:symbol "level" ; lv2:name "Level" ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 4.0
    ] .

<urn:openmixer:test:path-fixture#escape>
    a lv2:Plugin , lv2:UtilityPlugin ;
    doap:name "openmixer path fixture (escape twin)" ;
    lv2:requiredFeature urid:map , state:makePath ;
    lv2:extensionData state:interface ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 2 ; lv2:symbol "level" ; lv2:name "Level" ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 4.0
    ] .

<urn:openmixer:test:path-fixture#mappath>
    a lv2:Plugin , lv2:UtilityPlugin ;
    doap:name "openmixer path fixture (mapPath twin)" ;
    lv2:requiredFeature urid:map , state:mapPath ;
    lv2:optionalFeature state:freePath ;
    lv2:extensionData state:interface ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 2 ; lv2:symbol "level" ; lv2:name "Level" ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 4.0
    ] .
