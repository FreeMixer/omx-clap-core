# lv2_ll_midi_fixture.c's ports: MIDI through llext:MidiPort, ll-plugins' MIDI port (the event extension's
# predecessor), the port class zynadd declares its MIDI input as. #echo: a stereo pair in and out, one llext:MidiPort
# input and one output. #two-in: a mono pair and two llext:MidiPort inputs, one more than the adapter feeds, refused.
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix llext: <http://ll-plugins.nongnu.org/lv2/ext/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

llext:MidiPort
    a rdfs:Class ;
    rdfs:subClassOf lv2:Port ;
    rdfs:label "ll-plugins MIDI port" .

<urn:openmixer:test:ll-midi-fixture#echo>
    a lv2:Plugin , lv2:UtilityPlugin ;
    doap:name "openmixer ll-plugins MIDI echo" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "In L"
    ] , [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "In R"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Out L"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Out R"
    ] , [
        a llext:MidiPort , lv2:InputPort ; lv2:index 4 ; lv2:symbol "midi_in" ; lv2:name "MIDI In"
    ] , [
        a llext:MidiPort , lv2:OutputPort ; lv2:index 5 ; lv2:symbol "midi_out" ; lv2:name "MIDI Out"
    ] .

<urn:openmixer:test:ll-midi-fixture#two-in>
    a lv2:Plugin , lv2:UtilityPlugin ;
    doap:name "openmixer ll-plugins MIDI echo (two inputs twin)" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a llext:MidiPort , lv2:InputPort ; lv2:index 2 ; lv2:symbol "midi_a" ; lv2:name "MIDI A"
    ] , [
        a llext:MidiPort , lv2:InputPort ; lv2:index 3 ; lv2:symbol "midi_b" ; lv2:name "MIDI B"
    ] .
