<urn:omx:test:worker:mono#5>
    a lv2:Plugin ;
    doap:name "omx fake worker" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    lv2:extensionData work:interface ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a lv2:ControlPort , lv2:OutputPort ; lv2:index 2 ; lv2:symbol "latency" ; lv2:name "Latency" ;
        lv2:designation lv2:latency ; lv2:portProperty lv2:reportsLatency , lv2:integer
    ] .

<urn:omx:test:nan-always:mono#6>
    a lv2:Plugin ;
    doap:name "omx fake NaN from the start" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a lv2:ControlPort , lv2:OutputPort ; lv2:index 2 ; lv2:symbol "latency" ; lv2:name "Latency" ;
        lv2:designation lv2:latency ; lv2:portProperty lv2:reportsLatency , lv2:integer
    ] .

<urn:omx:test:props:mono#7>
    a lv2:Plugin ;
    doap:name "omx fake port properties" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a lv2:ControlPort , lv2:OutputPort ; lv2:index 2 ; lv2:symbol "latency" ; lv2:name "Latency" ;
        lv2:designation lv2:latency ; lv2:portProperty lv2:reportsLatency , lv2:integer
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 3 ; lv2:symbol "steps" ; lv2:name "Steps" ;
        lv2:portProperty lv2:integer ; lv2:default 2 ; lv2:minimum 0 ; lv2:maximum 8
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 4 ; lv2:symbol "on" ; lv2:name "On" ;
        lv2:portProperty lv2:toggled ; lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 5 ; lv2:symbol "mode" ; lv2:name "Mode" ;
        lv2:portProperty lv2:integer , lv2:enumeration ; lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 2 ;
        lv2:scalePoint [ rdfs:label "low" ; rdf:value 0 ] , [ rdfs:label "mid" ; rdf:value 1 ] , [ rdfs:label "high" ; rdf:value 2 ]
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 6 ; lv2:symbol "shape" ; lv2:name "Shape" ;
        lv2:portProperty lv2:enumeration ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 3 ;
        lv2:scalePoint [ rdfs:label "sine" ; rdf:value 0 ] , [ rdfs:label "square" ; rdf:value 3 ]
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 7 ; lv2:symbol "hidden" ; lv2:name "Hidden" ;
        lv2:portProperty pprops:notOnGUI ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 8 ; lv2:symbol "freq" ; lv2:name "Frequency" ;
        lv2:portProperty pprops:logarithmic ; lv2:default 1000 ; lv2:minimum 20 ; lv2:maximum 20000
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 9 ; lv2:symbol "tap" ; lv2:name "Tap" ;
        lv2:portProperty pprops:trigger ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 10 ; lv2:symbol "nodef" ; lv2:name "No default" ;
        lv2:minimum -3 ; lv2:maximum 3
    ] .
