# lv2_event_fixture.c's ports: MIDI through ev:EventPort, the event extension's port (atom's predecessor), each
# supporting midi:MidiEvent through ev:supportsEvent. #echo: a stereo pair in and out, one MIDI input and one MIDI
# output. #two: a mono pair, two MIDI inputs (the first the note path's, the second fed empty) and two MIDI outputs (the
# first the note output's, the second never read). #other-type: an ev:EventPort that supports an event type of its own
# and no MIDI, refused.
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix ev:    <http://lv2plug.in/ns/ext/event#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<urn:openmixer:test:event-fixture#echo>
    a lv2:Plugin , lv2:UtilityPlugin ;
    doap:name "openmixer event echo" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    lv2:requiredFeature <http://lv2plug.in/ns/ext/uri-map> , <http://lv2plug.in/ns/ext/event> ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "In L"
    ] , [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "In R"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Out L"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Out R"
    ] , [
        a ev:EventPort , lv2:InputPort ; ev:supportsEvent midi:MidiEvent ;
        lv2:index 4 ; lv2:symbol "midi_in" ; lv2:name "MIDI In"
    ] , [
        a ev:EventPort , lv2:OutputPort ; ev:supportsEvent midi:MidiEvent ;
        lv2:index 5 ; lv2:symbol "midi_out" ; lv2:name "MIDI Out"
    ] .

<urn:openmixer:test:event-fixture#two>
    a lv2:Plugin ;
    doap:name "openmixer event echo (two event ports each way twin)" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    lv2:requiredFeature <http://lv2plug.in/ns/ext/uri-map> ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a ev:EventPort , lv2:InputPort ; ev:supportsEvent midi:MidiEvent ;
        lv2:index 2 ; lv2:symbol "midi_a" ; lv2:name "MIDI A"
    ] , [
        a ev:EventPort , lv2:InputPort ; ev:supportsEvent midi:MidiEvent ;
        lv2:index 3 ; lv2:symbol "midi_b" ; lv2:name "MIDI B"
    ] , [
        a ev:EventPort , lv2:OutputPort ; ev:supportsEvent midi:MidiEvent ;
        lv2:index 4 ; lv2:symbol "midi_out_a" ; lv2:name "MIDI Out A"
    ] , [
        a ev:EventPort , lv2:OutputPort ; ev:supportsEvent midi:MidiEvent ;
        lv2:index 5 ; lv2:symbol "midi_out_b" ; lv2:name "MIDI Out B"
    ] .

<urn:openmixer:test:event-fixture#other-type>
    a lv2:Plugin ;
    doap:name "openmixer event echo (no MIDI event port twin)" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    lv2:requiredFeature <http://lv2plug.in/ns/ext/uri-map> , <http://lv2plug.in/ns/ext/event> ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a ev:EventPort , lv2:InputPort ; ev:supportsEvent <urn:openmixer:test:event-fixture#OtherEvent> ;
        lv2:index 2 ; lv2:symbol "events" ; lv2:name "Events"
    ] .

# the event extension's schema names no lv2:Feature for its own URI, nor the type of its own the twin supports: both
# stated here, so the bundle validates
<http://lv2plug.in/ns/ext/event>
    a lv2:Feature .

<urn:openmixer:test:event-fixture#OtherEvent>
    a rdfs:Class ;
    rdfs:subClassOf ev:Event ;
    rdfs:label "an event type of the twin's own, no MIDI" .
