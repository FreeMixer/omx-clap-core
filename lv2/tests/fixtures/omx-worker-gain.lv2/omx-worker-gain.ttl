# lv2_worker_gain.c's ports: mono in, mono out, gain_db.
@prefix doap:    <http://usefulinc.com/ns/doap#> .
@prefix lv2:     <http://lv2plug.in/ns/lv2core#> .
@prefix opts:    <http://lv2plug.in/ns/ext/options#> .
@prefix urid:    <http://lv2plug.in/ns/ext/urid#> .
@prefix work:    <http://lv2plug.in/ns/ext/worker#> .

<urn:openmixer:test:worker-gain>
    a lv2:Plugin , lv2:AmplifierPlugin ;
    doap:name "openmixer worker gain" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    lv2:requiredFeature urid:map , work:schedule , opts:options ;
    lv2:extensionData work:interface ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out"
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "gain_db" ;
        lv2:name "Gain" ;
        lv2:default 0.0 ;
        lv2:minimum -60.0 ;
        lv2:maximum 12.0
    ] .
