# The time-probe test plugin (lv2_time_probe.c) as a bundle of its own.
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:openmixer:test:time-probe>
    a lv2:Plugin ;
    lv2:binary <omx-time-probe.so> ;
    rdfs:seeAlso <omx-time-probe.ttl> .
