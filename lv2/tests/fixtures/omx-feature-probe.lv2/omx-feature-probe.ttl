# lv2_feature_probe.c's ports: mono in, mono out. The probe takes every feature as optional; its twin requires the worker.
@prefix bufsz: <http://lv2plug.in/ns/ext/buf-size#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix log:  <http://lv2plug.in/ns/ext/log#> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix opts: <http://lv2plug.in/ns/ext/options#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .
@prefix work: <http://lv2plug.in/ns/ext/worker#> .

<urn:openmixer:test:feature-probe>
    a lv2:Plugin , lv2:UtilityPlugin ;
    doap:name "openmixer feature probe" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    lv2:optionalFeature urid:map , urid:unmap , opts:options , bufsz:boundedBlockLength , work:schedule ,
        state:loadDefaultState , log:log , bufsz:fixedBlockLength , bufsz:powerOf2BlockLength ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out"
    ] .

<urn:openmixer:test:feature-probe#needs-worker>
    a lv2:Plugin , lv2:UtilityPlugin ;
    doap:name "openmixer feature probe (requires the worker)" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    lv2:requiredFeature work:schedule ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out"
    ] .
