# lv2_patch_fixture.c's ports and its writable properties. The gain scales the audio; the others are echoed back on
# the output, so a test reads every patch the plugin received. `name` is a string: it is not a parameter.
@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
@prefix fx:    <urn:openmixer:test:patch-fixture#> .

fx:gain
    a patch:Parameter ;
    rdfs:range atom:Float ;
    rdfs:label "Gain" ;
    lv2:symbol "gain" ;
    lv2:minimum 0.0 ;
    lv2:maximum 2.0 ;
    lv2:default 1.0 .

fx:mode
    a patch:Parameter ;
    rdfs:range atom:Int ;
    rdfs:label "Mode" ;
    lv2:symbol "mode" ;
    lv2:minimum 0 ;
    lv2:maximum 3 ;
    lv2:default 0 .

fx:flag
    a patch:Parameter ;
    rdfs:range atom:Bool ;
    rdfs:label "Flag" ;
    lv2:symbol "flag" .

# no lv2:symbol, no label and no bounds: the symbol comes from the URI, the bounds from the host's defaults
fx:level
    a patch:Parameter ;
    rdfs:range atom:Float .

fx:name
    a patch:Parameter ;
    rdfs:range atom:String ;
    rdfs:label "Name" ;
    lv2:symbol "name" .

<urn:openmixer:test:patch-fixture>
    a lv2:Plugin , lv2:AmplifierPlugin ;
    doap:name "openmixer patch fixture" ;
    lv2:requiredFeature urid:map ;
    patch:writable fx:gain , fx:mode , fx:flag , fx:level , fx:name ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a atom:AtomPort , lv2:InputPort ; atom:bufferType atom:Sequence ; atom:supports patch:Message ;
        lv2:index 2 ; lv2:symbol "patch_in" ; lv2:name "Patch in"
    ] , [
        a atom:AtomPort , lv2:OutputPort ; atom:bufferType atom:Sequence ; atom:supports patch:Message ;
        lv2:index 3 ; lv2:symbol "patch_out" ; lv2:name "Patch out"
    ] .

# the twin the host must refuse: its patch port also takes MIDI, which the patch mapping does not carry
<urn:openmixer:test:patch-fixture#midi>
    a lv2:Plugin ;
    doap:name "openmixer patch fixture (MIDI twin)" ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a atom:AtomPort , lv2:InputPort ; atom:bufferType atom:Sequence ;
        atom:supports patch:Message , midi:MidiEvent ; lv2:index 2 ; lv2:symbol "events" ; lv2:name "Events"
    ] .
