# The CV fixture (lv2_cv_fixture.c): one plugin with a binary, and two twins the host must refuse from the TTL alone.
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:openmixer:test:cv-fixture>
    a lv2:Plugin ;
    lv2:binary <omx-cv-fixture.so> ;
    rdfs:seeAlso <omx-cv-fixture.ttl> .

<urn:openmixer:test:cv-fixture#many>
    a lv2:Plugin ;
    lv2:binary <omx-cv-fixture.so> ;
    rdfs:seeAlso <omx-cv-fixture.ttl> .

<urn:openmixer:test:cv-fixture#many-out>
    a lv2:Plugin ;
    lv2:binary <omx-cv-fixture.so> ;
    rdfs:seeAlso <omx-cv-fixture.ttl> .
