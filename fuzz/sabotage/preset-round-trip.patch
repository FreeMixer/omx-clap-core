Caught by the seed input "escapes" of fuzz_preset.

diff --git a/src/preset_file.c b/src/preset_file.c
index 894de47..de307c4 100644
--- a/src/preset_file.c
+++ b/src/preset_file.c
@@ -541,7 +541,7 @@ static void put_string(struct pj_out *o, const char *s)
             continue;
         put(o, run, (size_t)(s - run));
         put(o, esc, n);
-        run = s + 1;
+        run = s;
     }
     put(o, run, (size_t)(s - run));
     put(o, "\"", 1);
