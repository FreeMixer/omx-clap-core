#
# commit-msg: refuse a message that carries an attribution line (tools/commit-message-check.sh;
# the patterns are tools/commit-message-patterns.json). Enable once per clone:
#   git config core.hooksPath .githooks
root=$(git rev-parse --show-toplevel) || exit 0
exec "$root/tools/commit-message-check.sh" --msg-file "$1"
