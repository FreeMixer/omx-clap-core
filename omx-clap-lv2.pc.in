prefix=@PREFIX@
libdir=@LIBDIR@
includedir=@INCLUDEDIR@

Name: omx-clap-lv2
Description: The LV2 adapter of omx-clap-host: one LV2 plugin presented as one CLAP plugin, as a static library; lilv is loaded at run time
Version: @VERSION@
Requires: clap
Requires.private: omx-clap-core
Libs: -L${libdir} -lomx-clap-lv2 -ldl -lpthread -lm
Cflags: -I${includedir}/omx-clap-lv2
